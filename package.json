{
  "name": "docwalk",
  "version": "0.0.0",
  "private": true,
  "description": "Walk a team through a GitHub Markdown + Mermaid design doc: slides from its headings, explorable diagrams, honest overflow.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm --filter docwalk-mcp build",
    "preview": "vite preview",
    "size": "node tooling/size-check.ts",
    "icons": "node tooling/icons.ts",
    "i18n": "node tooling/i18n-compile.ts",
    "typecheck": "pnpm i18n && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p worker/tsconfig.node.json && tsc --noEmit -p mcp/tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:design && pnpm fmt:check && pnpm test:all && pnpm test:worker && pnpm build",
    "lint:design": "design.md lint DESIGN.md",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "mutation": "stryker run",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "dev:worker": "pnpm build && wrangler dev --config worker/wrangler.jsonc",
    "deploy": "pnpm build && wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@drauu/core": "1.0.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "3.1.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@panzoom/panzoom": "4.6.2",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/primitive": "4.5.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "gemoji": "8.1.0",
    "github-slugger": "2.0.0",
    "hono": "4.13.14",
    "lucide-react": "1.64.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.2.0",
    "modern-screenshot": "4.7.0",
    "monaco-editor": "0.57.0",
    "perfect-freehand": "1.2.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "rehype-github-alert": "1.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "reveal.js": "6.0.2",
    "temml": "0.14.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "@fast-check/vitest": "0.5.0",
    "@google/design.md": "0.4.0",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-icu1": "1.3.4",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@size-limit/file": "14.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "fast-check": "4.10.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "size-limit": "14.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.155.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
